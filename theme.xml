<?xml version="1.0" encoding="UTF-8"?>
<!--

es-theme-minuark-4x3-media
  MinUI look for 4:3 / 640x480, with game media.
  Fork of es-theme-minuark-4x3 by offalynne (github.com/offalynne/es-theme-minuark-4x3),
  which is a 4:3 rewrite of es-theme-MinUArk by Vidnez,
  which is a port of MinUI by Shaun Inman.
  License: CC-BY-NC-SA (inherited)

  Media modes are selectable in ES: Start > UI Settings > Theme Configuration > Media.
  Video/art geometry follows the pattern proven on this device by RetroDark.

-->
<theme>
<formatVersion>7</formatVersion>

<variables>
  <!-- Media mode defaults = "Video panel". Overridden by ./options/media/*.xml -->
  <mediaVideoVisible>true</mediaVideoVisible>
  <mediaVideoPos>0.78 0.47</mediaVideoPos>
  <mediaVideoMaxSize>0.4 0.5</mediaVideoMaxSize>

  <mediaImageVisible>false</mediaImageVisible>
  <mediaImagePos>0.78 0.47</mediaImagePos>
  <mediaImageSize>0.4 0.45</mediaImageSize>
  <mediaImageTint>ffffff</mediaImageTint>
  <mediaImageOrigin>0 0</mediaImageOrigin>

  <!-- Gamelist geometry (this set leaves the right side free for media) -->
  <listPos>0.045 0.1</listPos>
  <listSize>0.53 0.78</listSize>
  <listFontSize>0.045</listFontSize>
  <listLineSpacing>1.8</listLineSpacing>
  <listMargin>0.055</listMargin>
  <listSelectorHeight>0.115</listSelectorHeight>
  <listSelectorWidth>1</listSelectorWidth>
</variables>

<include name="Configs">./config.xml</include>

<!-- System View (List Categories) -->
<view name="system">

<!-- System BG -->
<image name="staticBackground">
  <size>1 1</size>
  <pos>0 0</pos>
  <origin>0 0</origin>
  <tile>false</tile>
  <linearSmooth>true</linearSmooth>
  <path>./bg-home.png</path>
  <zIndex>0</zIndex>
</image>

<!-- System List -->
<carousel name="systemcarousel" extra="true">
  <type>vertical</type>
  <pos>0.074 0.026</pos>
  <size>1 0.77</size>
  <origin>0 0</origin>
  <color>00000000</color>
  <logoScale>1</logoScale>
  <logoSize>0.8 0.8</logoSize>
  <logoPos>0 0</logoPos>
  <fastScrolling>true</fastScrolling>
  <maxLogoCount>6</maxLogoCount>
</carousel>

<!-- System Category Title -->
<image name="logo">
  <path>./art/default.svg</path>
  <path>./art/${system.theme}.svg</path>
</image>

<!-- System Misc Text (Hide) -->
<text name="logoText"><visible>false</visible><pos>0 -1</pos></text>
<text name="systemInfo"><visible>false</visible><pos>0 -1</pos></text>

</view>

<!-- Category View (List Titles) -->
<view name="detailed, video, basic">

<!-- Category BG -->
<image name="background" extra="true">
  <origin>0 0</origin>
  <pos>0 0</pos>
  <size>1 1</size>
  <path>./bg-games.png</path>
  <zIndex>0</zIndex>
</image>

<!-- Game media: video, or its snapshot image when no video exists -->
<video name="md_video">
  <visible>${mediaVideoVisible}</visible>
  <origin>0.5 0.5</origin>
  <pos>${mediaVideoPos}</pos>
  <maxSize>${mediaVideoMaxSize}</maxSize>
  <delay>1</delay>
  <effect>none</effect>
  <showSnapshotNoVideo>true</showSnapshotNoVideo>
  <showSnapshotDelay>true</showSnapshotDelay>
  <snapshotSource>image</snapshotSource>
  <zIndex>2</zIndex>
</video>

<!-- Game media: static art (panel), or dimmed full-screen backdrop -->
<image name="md_image">
  <visible>${mediaImageVisible}</visible>
  <pos>${mediaImagePos}</pos>
  <size>${mediaImageSize}</size>
  <origin>${mediaImageOrigin}</origin>
  <color>${mediaImageTint}</color>
  <zIndex>1</zIndex>
</image>

<!-- Category List -->
<textlist name="gamelist">
  <selectorColor>f7fbf7</selectorColor>
  <selectedColor>000000</selectedColor>
  <primaryColor>f7fbf7</primaryColor>
  <secondaryColor>f7fbf7</secondaryColor>
  <fontPath>./BPreplayBold-unhinted.otf</fontPath>
  <backgroundCornerSize>1 1</backgroundCornerSize>
  <fontSize>${listFontSize}</fontSize>
  <pos>${listPos}</pos>
  <size>${listSize}</size>
  <alignment>left</alignment>
  <horizontalMargin>${listMargin}</horizontalMargin>
  <origin>0 0</origin>
  <lineSpacing>${listLineSpacing}</lineSpacing>
  <selectorImagePath>./selector.png</selectorImagePath>
  <selectorOffsetY>-0.01</selectorOffsetY>
  <selectorHeight>${listSelectorHeight}</selectorHeight>
  <selectorWidth>${listSelectorWidth}</selectorWidth>
  <zIndex>3</zIndex>
</textlist>

<!-- Category Misc (Hide) -->
<text name="md_lbl_genre, md_genre, md_lbl_rating, md_lbl_developer, md_lbl_publisher, md_publisher, md_lbl_lastplayed, md_lbl_playcount, md_playcount, md_lbl_releasedate, md_description"><visible>false</visible></text>
<rating name="md_rating"><visible>false</visible></rating>
<image name="md_thumbnail"><visible>false</visible></image>

</view>

<!-- Menu View -->
<view name="menu">

<!-- Menu Title -->
<menuText name="menutitle">
  <fontPath>./BPreplayBold-unhinted.otf</fontPath>
  <fontSize>0.043</fontSize>
  <color>ffffff</color>
</menuText>

<!-- Menu Footer -->
<menuText name="menufooter">
  <fontPath>./BPreplayBold-unhinted.otf</fontPath>
  <fontSize>0.04</fontSize>
  <color>ffffff</color>
</menuText>

<!-- Menu List -->
<menuText name="menutext">
  <fontPath>./BPreplayBold-unhinted.otf</fontPath>
  <fontSize>0.043</fontSize>
  <color>ffffff</color>
  <selectorColor>ffffff</selectorColor>
  <selectorColorEnd>ffffff</selectorColorEnd>
  <selectedColor>000000</selectedColor>
  <separatorColor>00000000</separatorColor>
</menuText>

<!-- Menu Text Small -->
<menuTextSmall name="menutextsmall">
  <fontPath>./BPreplayBold-unhinted.otf</fontPath>
  <fontSize>0.043</fontSize>
  <color>ffffff</color>
</menuTextSmall>

<!-- Menu Background -->
<menuBackground name="menubg"><color>000000</color></menuBackground>

</view>

<!-- Clock (Hide) -->
<text name="clock"><pos>0 -1</pos></text>

<!-- Prompts (Hide) -->
<view name="menu, system, detailed, video, basic"><helpsystem name="help"><pos>0 -1</pos></helpsystem></view>

</theme>
